# Copie para .env (não versionar) ou exporte como variáveis de ambiente.
# Supabase > Project Settings > Database > Connection string > JDBC (Session pooler, porta 5432)
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.SEU_PROJECT_REF
SPRING_DATASOURCE_PASSWORD=SUA_SENHA_DO_BANCO
SPRING_JPA_DDL_AUTO=update
JWT_SECRET=um-segredo-longo-e-aleatorio
JWT_EXPIRACAO_HORAS=8
CORS_ORIGENS=http://localhost:5173
APP_SEED_ENABLED=true
